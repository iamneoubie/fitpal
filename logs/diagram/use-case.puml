@startuml
left to right direction

actor Customer
actor Restaurant
actor "Delivery Rider" as Rider
actor Admin

rectangle "FitPal Food Delivery System" {

  usecase "Browse & Filter Menu" as UC1
  usecase "Manage Cart & Order" as UC2
  usecase "Customize Product" as UC3
  usecase "Track Order" as UC4
  usecase "Give Feedback" as UC5

  usecase "Kitchen Queue" as UC6
  usecase "View Order Details" as UC7
  usecase "Update Order Status" as UC8

  usecase "Manage Deliveries" as UC9
  usecase "Update Delivery Status" as UC10

  usecase "Manage Users" as UC11
  usecase "Verify Applications" as UC12
  usecase "View Analytics" as UC13
}

Customer --> UC1
Customer --> UC2
Customer --> UC3
Customer --> UC4
Customer --> UC5

Restaurant --> UC6
Restaurant --> UC7
Restaurant --> UC8

Rider --> UC9
Rider --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13

UC2 ..> UC3 : <<include>>
UC6 ..> UC7 : <<include>>

@enduml