[mysqld]
# ---------------------------------------------------------------------------
# FitPal my.cnf
# ---------------------------------------------------------------------------
#
# NOTE — READ BEFORE WONDERING WHY IT IS IGNORED
#
# This file is correct and is intended to be used by the MySQL
# container. However, on Windows the Docker Desktop WSL2 backend
# presents host bind mounts as world-writable (0777), and MySQL
# refuses to read world-writable config files. That produces:
#
#     mysql: [Warning] World-writable config file
#     '/etc/mysql/conf.d/my.cnf' is ignored.
#
# The bind mount for this file has therefore been removed from
# docker/docker-compose.yaml. MySQL uses its built-in defaults,
# which is exactly what the FitPal schema was written against
# (strict sql_mode, InnoDB, utf8mb4). This file is kept in the
# tree so a Linux or CI deployment can mount it and get the
# buffer-pool and timeout tuning below.
#
# Do NOT add the mount back on Windows. The warning is benign but
# it hides real warnings and slows every docker exec by a
# per-session check.
# ---------------------------------------------------------------------------

default-storage-engine=InnoDB
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci

skip-name-resolve
max_connections=200

log-error-verbosity=2

# ---------------------------------------------------------------------------
# sql_mode — DO NOT OVERRIDE
#
# The FitPal schema relies on MySQL 8.0's strict default sql_mode.
# Every CHECK constraint in database.sql (rating.score BETWEEN 1
# AND 5, product.price >= 0, queue_item.queue_quantity > 0, and
# the rating.subject_key STORED generated column) depends on
# STRICT_TRANS_TABLES actually being on. Setting
# sql_mode=NO_ENGINE_SUBSTITUTION here would silently bypass every
# one of them. Leave sql_mode alone.
# ---------------------------------------------------------------------------

innodb_buffer_pool_size=256M
innodb_flush_log_at_trx_commit=2
max_allowed_packet=64M

wait_timeout=28800
interactive_timeout=28800

[client]
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4